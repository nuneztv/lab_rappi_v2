{
  "name": "rappi-server",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/api.ts",
    "build": "tsc",
    "bundle": "npx -y esbuild@0.25.10 src/api.ts --bundle --platform=node --target=node20 --format=cjs --external:pg-native --banner:js=//@ts-nocheck --outfile=src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
